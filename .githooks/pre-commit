#!/usr/bin/env bash
# Pre-commit hook — auto-format Kotlin sources with ktlintFormat.
# Enabled per-clone with: git config core.hooksPath .githooks
# Bypass in emergencies (e.g. --no-verify semantics): git commit --no-verify
#
# ktlint changes style only (indentation, imports, line length...) — never
# semantics — so formatting in a commit hook is safe. The CI gate
# (ktlintCheck) stays the final proof.
#
# NOTE: a fresh checkout pays a one-time Gradle distribution/plugin download
# (minutes) on the first .kt commit; ktlintFormat covers every module, so
# untouched-unstaged Kotlin files may also change on disk.
set -euo pipefail

# Only act when the commit touches staged Kotlin sources.
STAGED_KT=$(git diff --cached --name-only --diff-filter=ACM -- '*.kt')
if [ -z "$STAGED_KT" ]; then
  exit 0
fi

# Files with unstaged changes. A partially-staged file has staged and unstaged
# hunks at once; re-staging its formatted working-tree copy would pull the
# unstaged hunks into the commit and change the reviewed content, so it is
# formatted on disk but its index entry is left as staged.
UNSTAGED_KT=$(git diff --name-only -- '*.kt' || true)

# `tools/gradle` is the wrapper's stand-in under a write-confined sandbox; it
# delegates to `./gradlew` wherever the default Gradle user home is writable.
runner="$(git rev-parse --show-toplevel)/tools/gradle"

echo "pre-commit: ktlintFormat…"
"$runner" ktlintFormat --quiet

restage() {
  local file="$1"
  if [ -n "$UNSTAGED_KT" ] && printf '%s\n' "$UNSTAGED_KT" | grep -qxF -- "$file"; then
    echo "pre-commit: $file is partially staged — formatted on disk; index left as staged" >&2
  else
    git add -- "$file"
  fi
}

while IFS= read -r f; do
  if [ -n "$f" ]; then
    restage "$f"
  fi
done <<< "$STAGED_KT"

echo "pre-commit: ktlintFormat done."
