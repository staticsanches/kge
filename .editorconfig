root = true

[*]
max_line_length = 120
# noinspection EditorConfigKeyCorrectness
ktlint_standard_argument-list-wrapping = disabled

# Files must end with exactly one final newline. ktlint 1.0.1 (ktlint_official)
# already enforces both directions (missing final newline and trailing blank
# line are violations); the explicit properties keep it that way if the
# ktlint defaults change on a future engine bump. Editors honor them too.
[*.{kt,kts}]
insert_final_newline = true
ktlint_standard_final-newline = enabled
ktlint_standard_no-consecutive-blank-lines = enabled
